---
import { faqs } from '../data/landing'
---
<section class="border-t border-ink-100 py-20 sm:py-28 dark:border-ink-800">
  <div class="container-page" data-rise>
    <p class="eyebrow">Questions</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
      The ones we get asked before the trial, not after.
    </h2>
    <dl class="mt-12 grid gap-x-14 gap-y-9 sm:grid-cols-2">
      {faqs.map((f) => (
        <div>
          <dt class="text-sm font-semibold text-ink-900 dark:text-white">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
