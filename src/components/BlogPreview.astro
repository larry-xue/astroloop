---
import { getCollection } from 'astro:content'
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
---
{posts.length > 0 && (
  <section class="border-t border-ink-100 py-20 sm:py-28 dark:border-ink-800">
    <div class="container-page" data-rise>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
            What we got wrong, in public.
          </h2>
        </div>
        <a href="/blog" class="text-sm text-ink-600 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white">All posts &rarr;</a>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="group block">
            <time datetime={p.data.date.toISOString()} class="font-mono text-xs text-ink-500 dark:text-ink-400">{fmt.format(p.data.date)}</time>
            <h3 class="mt-2 font-medium text-ink-900 group-hover:text-signal-600 dark:text-white dark:group-hover:text-signal-400">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
