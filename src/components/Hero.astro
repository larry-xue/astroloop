---
import { getCollection } from 'astro:content'
import { site } from '../data/site'
import AvatarStack from './AvatarStack.astro'
import HeroVisual from './HeroVisual.astro'

const people = (await getCollection('testimonials'))
  .map((t) => t.data)
  .filter((t) => t.featured)
  .sort((a, b) => a.order - b.order)
---
<section class="border-b border-ink-100 py-20 sm:py-28 dark:border-ink-800">
  <div class="container-page grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
    <div>
    <p class="eyebrow">Autonomous, on a leash</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-[1.08] tracking-tight text-ink-900 sm:text-6xl dark:text-white">
      {site.tagline}
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600 dark:text-ink-400">
      It reads the issue, writes the branch, opens the pull request, and stops
      at the merge button. You approve the three decisions that matter and skip
      the forty that do not.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a href="/pricing" class="rounded-lg bg-ink-900 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-ink-800 dark:bg-white dark:text-ink-900 dark:hover:bg-ink-100">
        Start free
      </a>
      <a href="#how-it-works" class="rounded-lg border border-ink-200 px-5 py-3 text-sm font-medium text-ink-800 transition-colors hover:border-ink-300 hover:bg-ink-50 dark:border-ink-700 dark:text-ink-200 dark:hover:border-ink-600 dark:hover:bg-ink-900">
        See what it does on its own
      </a>
    </div>
    <div class="mt-9">
      <AvatarStack people={people} label="Trusted by the people who had to approve it" />
    </div>

    <p class="mt-6 font-mono text-xs text-ink-500 dark:text-ink-400">
      No card. Every action logged. Revoke a tool and the next run respects it.
    </p>
    </div>

    <HeroVisual />
  </div>
</section>
