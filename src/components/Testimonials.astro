---
import { getCollection } from 'astro:content'
import Avatar from './Avatar.astro'

/**
 * Quotes about autonomy and trust, not about speed and ease.
 *
 * The security engineer is the one that matters. Every other agent product
 * page quotes a delighted developer; almost none of them quote the person
 * whose job is to say no, and that is exactly who blocks the purchase.
 *
 * Content lives in src/content/testimonials/testimonials.yaml.
 */
const quotes = (await getCollection('testimonials'))
  .map((t) => t.data)
  .sort((a, b) => a.order - b.order)
  .slice(0, 3)
---
<section class="border-t border-ink-100 py-20 sm:py-28 dark:border-ink-800">
  <div class="container-page" data-rise>
    <p class="eyebrow">What people say</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
      The people who had to sign off on it.
    </h2>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {quotes.map((q) => (
        <figure class="flex h-full flex-col rounded-2xl border border-ink-200 p-7 dark:border-ink-800">
          <svg class="size-5 shrink-0 text-signal-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M7.5 4C5 5.4 3.4 7.9 3.4 10.6c0 2.9 1.7 4.9 4 4.9 2 0 3.5-1.5 3.5-3.4 0-1.9-1.3-3.3-3.1-3.3-.4 0-.8.1-1 .2.3-1.4 1.5-2.9 3-3.8L7.5 4Zm8.4 0c-2.5 1.4-4.1 3.9-4.1 6.6 0 2.9 1.7 4.9 4 4.9 2 0 3.5-1.5 3.5-3.4 0-1.9-1.3-3.3-3.1-3.3-.4 0-.8.1-1 .2.3-1.4 1.5-2.9 3-3.8L15.9 4Z" />
          </svg>
          <blockquote class="mt-5 grow text-sm leading-relaxed text-ink-700 dark:text-ink-300">{q.quote}</blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-ink-100 pt-5 dark:border-ink-800">
            <Avatar name={q.name} avatar={q.avatar} />
            <div>
              <p class="text-sm font-medium text-ink-900 dark:text-white">{q.name}</p>
              <p class="mt-0.5 font-mono text-xs text-ink-500 dark:text-ink-400">{q.role}, {q.company}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
