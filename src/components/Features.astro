---
import { features } from '../data/landing'
---
<section class="border-t border-ink-100 py-20 sm:py-28 dark:border-ink-800">
  <div class="container-page" data-rise>
    <div class="grid gap-10 sm:grid-cols-3 sm:gap-8">
      {features.map((f, i) => (
        <div>
          <p class="font-mono text-xs text-signal-700 dark:text-signal-400">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-lg font-semibold text-ink-900 dark:text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
