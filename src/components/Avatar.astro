---
/**
 * No stock photos. A template that ships pictures of people who do not exist
 * is a licensing problem for whoever downloads it, and readers can tell.
 *
 * Initials with a hue derived from the name: zero assets, deterministic, and
 * it looks deliberate rather than missing. Add `avatar: /people/x.jpg` to a
 * testimonial and this renders that instead.
 */
interface Props {
  name: string
  avatar?: string | null
  size?: 'sm' | 'md'
  class?: string
}
const { name, avatar = null, size = 'md', class: className = '' } = Astro.props

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => [...w][0]?.toUpperCase() ?? '')
  .join('')

// Deterministic hue so the same person is always the same colour.
let h = 0
for (const ch of name) h = (h * 31 + ch.codePointAt(0)!) % 360

const box = size === 'sm' ? 'size-8 text-[11px]' : 'size-10 text-xs'
---
{avatar ? (
  <img
    src={avatar}
    alt=""
    width={size === 'sm' ? 32 : 40}
    height={size === 'sm' ? 32 : 40}
    loading="lazy"
    decoding="async"
    class={`${box} shrink-0 rounded-full object-cover ${className}`}
  />
) : (
  <span
    aria-hidden="true"
    class={`${box} inline-flex shrink-0 select-none items-center justify-center rounded-full font-medium tracking-wide ${className}`}
    style={`background: oklch(88% 0.06 ${h}); color: oklch(38% 0.10 ${h});`}
  >{initials}</span>
)}
