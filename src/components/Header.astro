---
import { Icon } from 'astro-icon/components'
import { site } from '../data/site'
---
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur-md dark:border-ink-800 dark:bg-ink-950/85">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-ink-900 dark:text-white">
      <svg class="size-5 text-signal-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" stroke-dasharray="30 14" />
        <circle cx="10" cy="3" r="2" fill="currentColor" />
      </svg>
      {site.name}
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label="Main">
      {site.nav.map((n) => (
        <a href={n.href} class="text-ink-600 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-white">{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="theme-toggle"
        class="rounded-md p-2 text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900 dark:hover:bg-ink-800 dark:hover:text-white"
        aria-label="Toggle dark mode"
      >
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
      </button>
      <a href="/pricing" class="rounded-lg bg-ink-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-ink-800 dark:bg-white dark:text-ink-900 dark:hover:bg-ink-100">
        Start free
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    localStorage.setItem('theme', dark ? 'dark' : 'light')
  })
</script>
