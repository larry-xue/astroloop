---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { getEntry } from 'astro:content'
import Avatar from '../../components/Avatar.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', year: 'numeric' })

const withAuthor = await Promise.all(
  posts.map(async (p) => ({
    post: p,
    author: p.data.author ? (await getEntry(p.data.author))?.data : undefined,
  })),
)
---
<Layout title="Blog" description="Notes on building and running agents in production.">
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        What we learned running this thing against real repositories.
      </h1>

      <ul class="mt-14 divide-y divide-ink-100 border-t border-ink-100 dark:divide-ink-800 dark:border-ink-800">
        {withAuthor.map(({ post: p, author }) => (
          <li>
            <a href={`/blog/${p.id}`} class="group grid gap-3 py-7 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
              <time datetime={p.data.date.toISOString()} class="font-mono text-xs text-ink-500 sm:pt-1 dark:text-ink-400">
                {fmt.format(p.data.date)}
              </time>
              <div>
                <h2
                  data-vt-post
                  style={`view-transition-name: post-${p.id.replace(/[^a-zA-Z0-9-]/g, '-')}`}
                  class="font-medium text-ink-900 group-hover:text-signal-700 dark:text-white dark:group-hover:text-signal-400"
                >{p.data.title}</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{p.data.description}</p>
                {author && (
                  <span class="mt-3 flex items-center gap-2">
                    <Avatar name={author.name} avatar={author.avatar} size="sm" />
                    <span class="font-mono text-xs text-ink-500 dark:text-ink-400">{author.name}</span>
                  </span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
      {posts.length === 0 && <p class="mt-10 text-ink-500">No posts yet. Add markdown files to <code class="font-mono text-sm">src/content/blog/</code>.</p>}
    </div>
  </section>
</Layout>
