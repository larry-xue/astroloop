---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import AuthorLine from '../../components/AuthorLine.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
---
<Layout title={post.data.title} description={post.data.description}>
  <article class="py-20 sm:py-28">
    <div class="container-page max-w-2xl">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight text-ink-900 sm:text-4xl dark:text-white">{post.data.title}</h1>
      <p class="mt-4 text-lg text-ink-600 dark:text-ink-400">{post.data.description}</p>
      <div class="mt-8 border-t border-ink-100 pt-6 dark:border-ink-800">
        <AuthorLine author={post.data.author} date={post.data.date} />
      </div>
      <div class="post-body mt-12">
        <Content />
      </div>
      <div class="mt-16 rounded-2xl border border-ink-200 p-7 dark:border-ink-800">
        <AuthorLine author={post.data.author} date={post.data.date} showBio />
      </div>

      <a href="/blog" class="mt-12 inline-block text-sm text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white">&larr; All posts</a>
    </div>
  </article>
</Layout>

<style>
  /* Tailwind 4 compiles component styles separately, so @apply needs to be
     told where the theme lives. Without this the build fails on the first
     unknown utility. */
  @reference "../../styles/global.css";

  .post-body :global(h2) { @apply mt-10 mb-3 text-xl font-semibold text-ink-900 dark:text-white; }
  .post-body :global(h3) { @apply mt-8 mb-2 text-base font-semibold text-ink-900 dark:text-white; }
  .post-body :global(p)  { @apply mb-5 leading-relaxed text-ink-700 dark:text-ink-300; }
  .post-body :global(ul) { @apply mb-5 list-disc space-y-1.5 pl-5 text-ink-700 dark:text-ink-300; }
  .post-body :global(a)  { @apply text-signal-700 underline underline-offset-4 dark:text-signal-400; }
  .post-body :global(code) { @apply rounded bg-ink-100 px-1.5 py-0.5 font-mono text-[0.875em] text-ink-800 dark:bg-ink-800 dark:text-ink-200; }
  .post-body :global(pre) { @apply mb-6 overflow-x-auto rounded-xl border border-ink-200 p-5 text-[13px] leading-relaxed dark:border-ink-800; }
  .post-body :global(pre code) { @apply bg-transparent p-0; }
  .post-body :global(blockquote) { @apply mb-5 border-l-2 border-signal-500 pl-5 text-ink-600 italic dark:text-ink-400; }
</style>
