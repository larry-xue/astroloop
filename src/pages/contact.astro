---
import Layout from '../layouts/Layout.astro'
import { site } from '../data/site'
---
<Layout title="Contact" description="Get in touch.">
  <section class="py-20 sm:py-28">
    <div class="container-page grid gap-14 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)]">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">Ask us something specific.</h1>
        <p class="mt-4 text-ink-600 dark:text-ink-400">
          Tell us what the agent would have to touch in your setup and we will
          tell you honestly whether it can.
        </p>
        <p class="mt-8 font-mono text-sm text-ink-500 dark:text-ink-400">{site.email}</p>
      </div>

      <!-- Point action at Formspree, Netlify Forms, or your own handler. -->
      <form class="grid gap-5" method="POST" action="#">
        <div class="grid gap-2">
          <label for="name" class="text-sm font-medium text-ink-800 dark:text-ink-200">Name</label>
          <input id="name" name="name" type="text" required class="rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 outline-none focus:border-signal-500 focus:ring-2 focus:ring-signal-500/25 dark:border-ink-700 dark:bg-ink-900 dark:text-white" />
        </div>
        <div class="grid gap-2">
          <label for="email" class="text-sm font-medium text-ink-800 dark:text-ink-200">Email</label>
          <input id="email" name="email" type="email" required class="rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 outline-none focus:border-signal-500 focus:ring-2 focus:ring-signal-500/25 dark:border-ink-700 dark:bg-ink-900 dark:text-white" />
        </div>
        <div class="grid gap-2">
          <label for="message" class="text-sm font-medium text-ink-800 dark:text-ink-200">What would it need to touch?</label>
          <textarea id="message" name="message" rows="6" required class="rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 outline-none focus:border-signal-500 focus:ring-2 focus:ring-signal-500/25 dark:border-ink-700 dark:bg-ink-900 dark:text-white"></textarea>
        </div>
        <button type="submit" class="justify-self-start rounded-lg bg-ink-900 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-ink-800 dark:bg-white dark:text-ink-900 dark:hover:bg-ink-100">Send</button>
      </form>
    </div>
  </section>
</Layout>
