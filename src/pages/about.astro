---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Avatar from '../components/Avatar.astro'
import CTA from '../components/CTA.astro'
import { stats } from '../data/landing'

const team = (await getCollection('authors')).map((a) => a.data)
---
<Layout title="About" description="Who builds it, and what we decided not to do.">
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <p class="eyebrow">About</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        We deleted the chat box and the product got better.
      </h1>
      <div class="mt-8 grid max-w-4xl gap-8 sm:grid-cols-2">
        <p class="leading-relaxed text-ink-600 dark:text-ink-400">
          For six months this was a chat window, because that is what everything
          is. You described what you wanted, it asked clarifying questions, and
          eventually work happened.
        </p>
        <p class="leading-relaxed text-ink-600 dark:text-ink-400">
          The problem was that "please do not merge without asking" and "the
          system cannot merge without approval" looked identical in that box.
          Now one is a file and the other is a sentence, and only one of them
          holds.
        </p>
      </div>

      <div class="mt-16 grid gap-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div>
            <p class="text-3xl font-semibold tracking-tight text-ink-900 dark:text-white">{s.value}</p>
            <p class="mt-1.5 text-sm font-medium text-ink-700 dark:text-ink-300">{s.label}</p>
            <p class="mt-1 font-mono text-xs text-ink-500 dark:text-ink-400">{s.note}</p>
          </div>
        ))}
      </div>

      <h2 class="mt-20 text-xl font-semibold text-ink-900 dark:text-white">The people</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {team.map((m) => (
          <div class="flex gap-4">
            <Avatar name={m.name} avatar={m.avatar} />
            <div>
              <p class="font-medium text-ink-900 dark:text-white">{m.name}</p>
              <p class="mt-0.5 font-mono text-xs text-ink-500 dark:text-ink-400">{m.role}</p>
              {m.bio && <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{m.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CTA />
</Layout>
