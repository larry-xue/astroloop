---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Not found" description="That page does not exist.">
  <section class="py-28 sm:py-40">
    <div class="container-page">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        This one stopped and waited for a person too.
      </h1>
      <p class="mt-4 max-w-md text-ink-600 dark:text-ink-400">The page is not here. Nothing was deleted.</p>
      <a href="/" class="mt-8 inline-block rounded-lg bg-ink-900 px-5 py-3 text-sm font-medium text-white hover:bg-ink-800 dark:bg-white dark:text-ink-900 dark:hover:bg-ink-100">Back home</a>
    </div>
  </section>
</Layout>
